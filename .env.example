# YiMao runtime configuration
# Copy to .env, replace placeholders, then run: chmod 600 .env

# Required: Telegram Bot created with @BotFather.
TELEGRAM_BOT_TOKEN=replace-with-bot-token

# Required: comma-separated Telegram numeric IDs. The first ID becomes root admin.
# /link binds a MoviePilot account; it does not grant administrator privileges.
ADMIN_USER_IDS=replace-with-telegram-user-id

# Optional group/community notification destination.
TELEGRAM_CHAT_ID=

# Required: MoviePilot address reachable from the HOST because YiMao uses host network.
# Set the real deployment URL explicitly; do not rely on a historical host port.
MOVIEPILOT_URL=
MOVIEPILOT_API_KEY=replace-with-moviepilot-api-key
DOWNLOAD_SAVE_PATH=

# Required while API authentication is enabled. JSON object; every key >= 16 characters.
ENABLE_API_AUTH=true
API_KEYS={"replace-with-at-least-32-random-characters":"deployment"}
ENABLE_RATE_LIMIT=true
ENABLE_IP_BLOCKING=true

# Recommended: Emby/Jellyfin availability checks and real "ready to watch" notifications.
# Set both or leave both empty.
EMBY_URL=
EMBY_API_KEY=
EMBY_USER_ID=
EMBY_SKIP_TLS_VERIFY=false

# Recommended for inbound Emby/MoviePilot webhooks. Use a random high-entropy value.
WEBHOOK_SECRET=

# Optional: Telegram update webhook. Polling is used when WEBHOOK_URL is empty.
# Both values are required together. WEBHOOK_URL points to YiMao /webhook.
WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# Optional: public HTTPS App-first Mini App base URL. Do not include credentials,
# query parameters, or a fragment. This also enables the Bot menu button.
# `./manage.sh telegram` appends the Git revision to Telegram's default menu URL.
# Example: https://bot.example.com/miniapp
MINI_APP_URL=

# Optional metadata and AI integrations.
TMDB_API_KEY=
AI_ENABLED=false
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
ZHIPU_API_KEY=
CLAUDE_API_KEY=

# Optional runtime settings.
PORT=8080
HOST=0.0.0.0
TZ=Asia/Shanghai
LOG_LEVEL=info
LOG_PREFIX=YiMao
LOG_COLOR=false
NOTIFICATION_FORMAT=detailed
ENABLE_AUTO_RESUBSCRIBE=false
MAX_SESSION_AGE=24
MAX_SESSIONS=1000

# Container starts as root only long enough to fix volume ownership, then uses this UID/GID.
# Keep 0:0 when Docker socket access is needed and its group mapping is not configured.
PUID=0
PGID=0

# Optional request/wish behavior.
WISH_RESEARCH_INTERVAL_HOURS=24
WISH_EXPIRE_DAYS=30
WISH_MIN_SEEDERS=1
WISH_SEARCH_LOCK_TTL_MINUTES=60
DAILY_SUMMARY_HOUR=21
ENABLE_RICH_MESSAGE=true
UI_STYLE=card

# Optional read-only Mini App monitoring. These URLs are server-side only and must never be returned to clients.
# Leave both empty to fail closed. Deployment must inject live endpoints explicitly;
# Telegram initData, Cookie and Authorization headers are never forwarded upstream.
MONITOR_OVERVIEW_URL=
# Used only when overview omits qBittorrent free-space data.
MONITOR_QBIT_MAINDATA_URL=

# Optional MoviePilot password reset integration. Docker socket is mounted by default.
MOVIEPILOT_CONTAINER=moviepilot-v2
MOVIEPILOT_DB_PATH=/config/user.db
