# ========================================
# YiMao Telegram Bot 配置文件
# ========================================

# --------------------
# Telegram 配置 (必需)
# --------------------
# 从 @BotFather 创建机器人获取
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 管理员 Telegram ID，多个用逗号分隔
# 从 @userinfobot 获取你的 ID
ADMINS=123456789,987654321

# --------------------
# MoviePilot 配置 (必需)
# --------------------
# MoviePilot 地址
MOVIEPILOT_URL=http://localhost:4500

# MoviePilot API Key (在 MoviePilot 设置中查看)
MOVIEPILOT_API_KEY=your_moviepilot_api_key

# --------------------
# Emby 配置 (可选但推荐)
# --------------------
# Emby/Jellyfin 地址
EMBY_URL=http://localhost:8096

# Emby API Key
EMBY_API_KEY=your_emby_api_key

# Emby 用户 ID
EMBY_USER_ID=

# 通知格式 (simple 或 detailed，默认 detailed)
# simple: 简洁格式，detailed: 详细格式
NOTIFICATION_FORMAT=detailed

# --------------------
# TMDB 配置 (可选)
# --------------------
# TMDB API Key，不填使用内置默认值
TMDB_API_KEY=

# --------------------
# AI 服务配置 (可选)
# --------------------
# 智谱 AI API Key (用于推荐功能)
ZHIPU_API_KEY=

# Claude API Key
CLAUDE_API_KEY=

# --------------------
# 安全配置
# --------------------
# API 访问密钥 (用于 Webhook 验证)
API_KEY=change_this_random_string

# --------------------
# 其他配置
# --------------------
# 服务端口
PORT=8080

# 时区
TZ=Asia/Shanghai
