# ========================================
# YiMao Telegram Bot 配置文件
# ========================================

# --------------------
# Telegram 配置 (必需)
# --------------------
# 从 @BotFather 创建机器人获取
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 管理员配置（推荐配置）
# 首次部署后，使用 /link 命令绑定的第一个用户会自动成为管理员
# 或者在此处直接指定管理员 Telegram ID（逗号分隔）
# 获取 ID: @userinfobot 或 https://t.me/userinfobot
ADMIN_USER_IDS=

# 群组 Chat ID (可选，用于群组通知)
# 留空则不发送群组通知
TELEGRAM_CHAT_ID=

# --------------------
# MoviePilot 配置 (必需)
# --------------------
# MoviePilot 地址
# ⚠️ 注意：如果 MoviePilot 不在本机，请修改为实际地址
# 示例：http://192.168.1.100:4500 或 http://moviepilot:4500
MOVIEPILOT_URL=http://localhost:4500

# MoviePilot API Key (在 MoviePilot 设置->安全设置中查看)
# ⚠️ 候选资源列表功能依赖此配置
MOVIEPILOT_API_KEY=your_moviepilot_api_key

# 密码重置（/resetpw，可选，默认关闭）
# 如需启用，请使用 docker-compose.resetpw.yml 挂载 /var/run/docker.sock，
# 并按实际 MoviePilot 容器名/容器内 user.db 路径配置以下变量。
# MOVIEPILOT_CONTAINER=moviepilot-v2
# MOVIEPILOT_DB_PATH=/config/user.db

# 下载保存目录 (可选，多服务器部署时使用)
# 如果你有多个服务实例共用一个 MoviePilot，可以指定不同的下载目录
# 例如：服务器A配置为 /downloads/server1，服务器B配置为 /downloads/server2
# 留空则使用 MoviePilot 默认下载目录
# DOWNLOAD_SAVE_PATH=/downloads/server1

# --------------------
# Emby 配置 (可选但推荐)
# --------------------
# Emby/Jellyfin 地址
EMBY_URL=http://localhost:8096

# Emby API Key
EMBY_API_KEY=your_emby_api_key

# 通知格式 (simple 或 detailed，默认 detailed)
# simple: 简洁格式，detailed: 详细格式
NOTIFICATION_FORMAT=detailed

# --------------------
# TMDB 配置 (可选)
# --------------------
# TMDB API Key，不填使用内置默认值
TMDB_API_KEY=

# --------------------
# AI 服务配置 (可选)
# --------------------
# 智谱 AI API Key (用于推荐功能)
ZHIPU_API_KEY=

# Anthropic/Claude API Key (用于 AI 功能)
# 支持 CLAUDE_API_KEY 或 ANTHROPIC_API_KEY 两种写法
CLAUDE_API_KEY=

# --------------------
# 其他配置
# --------------------
# 服务端口
PORT=8080

# 时区
TZ=Asia/Shanghai

# --------------------
# 日志配置
# --------------------
# 日志级别 (debug, info, warn, error，默认 info)
LOG_LEVEL=info

# 日志前缀 (用于识别模块，默认 YiMao)
LOG_PREFIX=YiMao

# 彩色日志输出 (true/false，默认 false)
# 在终端中查看时建议启用
LOG_COLOR=false

# --------------------
# 容器用户权限配置
# --------------------
# 容器内运行用户的 UID/GID
# 默认 0:0 即 root 用户，保证与 data 目录权限兼容
# 如需以非 root 用户运行，可设置为你的用户 UID/GID
# 使用命令 `id` 可查看当前用户的 UID/GID
# PUID=0
# PGID=0

# --------------------
# #6 求片许愿池（Batch B）
# --------------------
# 重搜调度间隔/锁定窗口（小时），默认 24。崩溃残留的旧锁超过该窗口会自动重纳入（自愈）。
WISH_RESEARCH_INTERVAL_HOURS=24
# 入池后无源自动过期天数，默认 30。超期会触发一次最终重搜，仍无源则取消并私信发起人。
WISH_EXPIRE_DAYS=30
# 重搜「命中」判定的最低做种数，默认 1。
WISH_MIN_SEEDERS=1

# --------------------
# AI 功能
# --------------------
# 设为 true 可显示 AI 推荐按钮（适用于 Mimo / OpenAI 兼容 / Zhipu / Claude 等提供商）
# AI_ENABLED=true
# OPENAI_BASE_URL=https://example.com/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=

# Telegram Rich Message（可选，默认 true；旧客户端/异常时可关闭）
# ENABLE_RICH_MESSAGE=true

# --------------------
# UI 主题风格
# --------------------
# 可选: neon(暗黑霓虹) / film(文艺胶片) / pop(波普) / card(极简卡片) / cinema(沉浸电影)
# UI_STYLE=card

# --------------------
# 每日汇总时间
# --------------------
# 每日入库汇总推送时间（小时，24h 制），默认 21
# DAILY_SUMMARY_HOUR=21

# --------------------
# Webhook 验签
# --------------------
# 设置后 Emby/MoviePilot Webhook 请求必须携带此 Token
# WEBHOOK_SECRET=
