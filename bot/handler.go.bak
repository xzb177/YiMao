package bot

import (
	"encoding/json"
	"fmt"
	"log"
	"regexp"
	"strconv"
	"strings"
	"sync"

	"github.com/gin-gonic/gin"
	"emby-telegram-bot/bot/response"
	"emby-telegram-bot/bot/types"
	"emby-telegram-bot/callback"
	"emby-telegram-bot/session"
)

// 使用 types 包中的类型别名，保持向后兼容
type MessageResponse = types.MessageResponse
type CallbackResponse = types.CallbackResponse

// AIAgent defines the interface for AI agent
type AIAgent interface {
	ProcessMessage(userID int64, message string) (string, error)
	IsEnabled() bool
}

// Handler handles incoming bot messages
type Handler struct {
	sessionManager *session.SessionManager
	callbackParser *callback.CallbackParser
	messageEditor  *MessageEditor
	quotaManager   *QuotaManager
	feedbackManager *FeedbackManager
	resp           *response.Integration // 响应系统集成

	// AI Agent
	aiAgent        AIAgent
	aiEnabled      bool

	// Admin list
	admins map[int64]string

	// Event handlers
	searchHandlers   map[string]SearchHandler
	subscribeHandlers map[string]SubscribeHandler
	downloadHandlers map[string]DownloadHandler

	mu sync.RWMutex
}

// SearchHandler handles search requests
type SearchHandler func(userID int64, query string, page int) (*SearchResult, error)

// SubscribeHandler handles subscribe requests
type SubscribeHandler func(userID int64, mediaID string, season int) error

// DownloadHandler handles download requests
type DownloadHandler func(userID int64, torrentID string) error

// SearchResult contains search results
type SearchResult struct {
	Query    string
	Page     int
	PageSize int
	Total    int
	Items    []session.SearchItem
}

// Import SearchItem from session package
type SearchItem = session.SearchItem

// NewHandler creates a new bot handler
func NewHandler() *Handler {
	h := &Handler{
		sessionManager: session.NewSessionManager(),
		callbackParser: callback.NewCallbackParser(),
		messageEditor:  NewMessageEditor(),
		resp:           response.NewIntegration(), // 初始化响应系统
		searchHandlers: make(map[string]SearchHandler),
		subscribeHandlers: make(map[string]SubscribeHandler),
		downloadHandlers: make(map[string]DownloadHandler),
	}

	// Start session cleanup goroutine
	go h.sessionManager.StartCleanup()

	return h
}

// SetAIAgent sets the AI agent
func (h *Handler) SetAIAgent(agent AIAgent) {
	h.mu.Lock()
	defer h.mu.Unlock()
	h.aiAgent = agent
	h.aiEnabled = (agent != nil)
}

// RegisterSearchHandler registers a search handler
func (h *Handler) RegisterSearchHandler(key string, handler SearchHandler) {
	h.mu.Lock()
	defer h.mu.Unlock()
	h.searchHandlers[key] = handler
}

// RegisterSubscribeHandler registers a subscribe handler
func (h *Handler) RegisterSubscribeHandler(key string, handler SubscribeHandler) {
	h.mu.Lock()
	defer h.mu.Unlock()
	h.subscribeHandlers[key] = handler
}

// RegisterDownloadHandler registers a download handler
func (h *Handler) RegisterDownloadHandler(key string, handler DownloadHandler) {
	h.mu.Lock()
	defer h.mu.Unlock()
	h.downloadHandlers[key] = handler
}

// HandleMessage processes an incoming message
func (h *Handler) HandleMessage(update *TelegramUpdate) *MessageResponse {
	if update.Message == nil {
		return nil
	}

	message := update.Message
	userID := message.From.ID
	chatID := message.Chat.ID
	chatType := message.Chat.Type
	text := message.Text

	if text == "" {
		return nil
	}

	log.Printf("[Handler] User %d (chat type: %s): %s", userID, chatType, text)

	// Check rate limit (but skip for admins)
	if !h.isAdmin(userID) {
		if limited, msg := CheckRateLimit(userID); limited {
			log.Printf("[Handler] Rate limit exceeded for user %d", userID)
			return &MessageResponse{
				Text: msg,
			}
		}
		// Record this request
		RecordRequest(userID)
	}

	// 限制：搜索功能仅在私聊中使用
	if chatType != "private" && !strings.HasPrefix(text, "/") {
		// 非私聊且不是命令，忽略
		log.Printf("[Handler] Ignoring non-private chat message")
		return nil
	}

	// Get or create user session
	session := h.sessionManager.GetOrCreateSession(userID, chatID)

	// Update last active time
	session.UpdateActivity()

	// Handle different message types
	switch {
	case strings.HasPrefix(text, "/"):
		return h.handleCommand(session, text)

	case strings.HasPrefix(text, "CALLBACK:"):
		// This should be handled by callback handler
		return nil

	case h.isNumericInput(text):
		return h.handleNumericInput(session, text)

	case strings.HasPrefix(text, "搜索"), strings.HasPrefix(text, "订阅"), strings.HasPrefix(text, "洗版"):
		return h.handleActionKeyword(session, text)

	case text == "p" || text == "P":
		return h.handlePagination(session, -1)

	case text == "n" || text == "N":
		return h.handlePagination(session, 1)

	default:
		// Try AI intelligent response first
		if h.aiEnabled {
			return h.handleAIIntent(session, text)
		}
		// Fallback to search
		return h.handleSearch(session, text)
	}
}

// HandleCallback processes a callback query
func (h *Handler) HandleCallback(update *TelegramUpdate) *CallbackResponse {
	if update.CallbackQuery == nil {
		return nil
	}

	callback := update.CallbackQuery
	userID := callback.From.ID

	log.Printf("[Handler] Callback from user %d: %s", userID, callback.Data)

	// Parse callback data
	cb, err := h.callbackParser.Parse(callback.Data)
	if err != nil {
		log.Printf("[Handler] Failed to parse callback: %v", err)
		return &CallbackResponse{
			ShowAlert: true,
			Text:     "无效的操作",
		}
	}

	// Get user session
	session := h.sessionManager.GetSession(userID)
	if session == nil {
		return &CallbackResponse{
			ShowAlert: true,
			Text:     "会话已过期，请重新开始",
		}
	}

	session.UpdateActivity()

	// Handle different callback actions
	switch cb.Action {
	case "select":
		return h.handleSelectCallback(session, cb)

	case "search":
		return h.handleSearchCallback(session, cb)

	case "rate_menu":
		return h.handleRateMenuCallback(session, cb)

	case "rate":
		return h.handleRateCallback(session, cb)

	case "subscribe":
		return h.handleSubscribeCallback(session, cb)

	case "download":
		return h.handleDownloadCallback(session, cb)

	case "page":
		return h.handlePageCallback(session, cb)

	case "cancel":
		return h.handleCancelCallback(session, cb)

	case "back":
		return h.handleBackCallback(session, cb)

	case "lang":
		return h.handleLanguageCallback(session, cb)

	case "profile":
		return h.handleProfileCallback(session, cb)

	case "rec":
		return h.handleRecommendCallback(session, cb)

	case "quick_request":
		return h.handleQuickRequestCallback(session, cb)

	default:
		return &CallbackResponse{
			ShowAlert: false,
			Text:     "未知操作",
		}
	}
}

// handleCommand handles slash commands
func (h *Handler) handleCommand(session *session.UserSession, command string) *MessageResponse {
	parts := strings.Fields(command)
	if len(parts) == 0 {
		return nil
	}

	cmd := parts[0]
	args := ""
	if len(parts) > 1 {
		args = strings.Join(parts[1:], " ")
	}

	switch cmd {
	case "/start", "/help":
		return h.sendHelpMessage(session)

	case "/search":
		if args == "" {
			return h.resp.InvalidInput("请输入搜索内容\n格式: /search 电影名称")
		}
		return h.handleSearch(session, args)

	case "/subscribe":
		if args == "" {
			return h.resp.InvalidInput("请输入订阅内容\n格式: /subscribe 电影名称")
		}
		return h.handleSubscribeCommand(session, args)

	case "/my":
		return h.handleMyRequests(session)

	case "/status":
		return h.handleStatus(session)

	case "/pending":
		return h.handlePending(session)

	case "/feedback", "/fb":
		return h.handleFeedback(session, args)

	case "/issues":
		return h.handleMyIssues(session)

	case "/allissues":
		return h.handleAllIssues(session)

	case "/rate":
		return h.handleRateCommand(session, args)

	case "/rating", "/ratings":
		return h.handleRatingsCommand(session)

	case "/lang", "/language":
		return h.handleLanguageCommand(session, args)

	case "/profile", "/me":
		return h.handleProfileCommand(session)

	case "/recommend", "/rec":
		return h.handleRecommendCommand(session, args)

	case "/ai":
		return h.handleAICommand(session, args)

	default:
		return h.resp.InvalidInput(fmt.Sprintf("未知命令: %s\n\n使用 /help 查看帮助", cmd))
	}
}

// handleAICommand handles AI command
func (h *Handler) handleAICommand(session *session.UserSession, args string) *MessageResponse {
	if !h.aiEnabled {
		return h.resp.Info("🤖 **AI 智能助手**\n\n" +
			"AI 功能暂未启用。请联系管理员配置 Claude API Key。")
	}

	if args == "" {
		return h.resp.Info("🤖 **AI 智能助手**\n\n" +
			"我可以帮你：\n\n" +
			"• **推荐** - `/ai 推荐 悬疑片` - 获取心情推荐\n" +
			"• **解释** - `/ai 解释 肖申克的救赎` - 了解电影简介\n" +
			"• **搜索** - `/ai 搜索 科幻片` - 智能搜索\n" +
			"• **心情** - `/ai 心情 开心` - 获取适合心情的推荐\n\n" +
			"• **对话** - 直接和我说你想要什么！")
	}

	// Call AI agent
	response, err := h.aiAgent.ProcessMessage(session.UserID, args)
	if err != nil {
		return h.resp.Error(fmt.Sprintf("AI 错误: %v", err))
	}

	return h.resp.Success(response)
}

// handleAIIntent handles natural language intent with AI
func (h *Handler) handleAIIntent(session *session.UserSession, text string) *MessageResponse {
	// Skip very short text or pure numbers
	if len(text) <= 1 || h.isNumericInput(text) {
		return h.handleSearch(session, text)
	}

	// Skip if it's obviously a search (like "复仇者联盟" or "2024年的电影")
	if h.isLikelySearch(text) {
		return h.handleSearch(session, text)
	}

	log.Printf("[Handler] Using AI for intent: %s", text)

	// Use AI to understand intent and get response
	response, err := h.aiAgent.ProcessMessage(session.UserID, text)
	if err != nil {
		log.Printf("[Handler] AI error: %v", err)
		// Fallback to search
		return h.handleSearch(session, text)
	}

	// Check if AI returned a structured search request
	if h.isSearchRequest(response) {
		// Extract search term and perform search
		searchTerm := h.extractSearchTerm(response)
		return h.handleSearch(session, searchTerm)
	}

	return h.resp.Success(response)
}

// isLikelySearch checks if text is likely a direct search query
func (h *Handler) isLikelySearch(text string) bool {
	// Short titles (like "泰坦尼克号" or "Inception")
	if len(text) <= 20 && !strings.Contains(text, "推荐") && !strings.Contains(text, "好看") && !strings.Contains(text, "想看") {
		return true
	}
	// Year pattern like "2024年的电影"
	if matched, _ := regexp.MatchString(`^\d{4}年`, text); matched {
		return true
	}
	return false
}

// isSearchRequest checks if AI response is a search request
func (h *Handler) isSearchRequest(response string) bool {
	keywords := []string{"搜索", "search", "为你搜索", "正在搜索", "让我搜"}
	for _, kw := range keywords {
		if strings.Contains(strings.ToLower(response), strings.ToLower(kw)) {
			return true
		}
	}
	return false
}

// extractSearchTerm extracts search term from AI response
func (h *Handler) extractSearchTerm(response string) string {
	// Look for quoted terms or specific patterns
	re := regexp.MustCompile(`["|""](.*?)["|"']`)
	matches := re.FindAllStringSubmatch(response, -1)
	if len(matches) > 0 {
		return matches[0][1]
	}
	// Fallback: return last 20 characters
	if len(response) > 20 {
		return strings.TrimSpace(response[len(response)-20:])
	}
	return response
}

// handleFeedback handles feedback command
func (h *Handler) handleFeedback(session *session.UserSession, args string) *MessageResponse {
	if h.feedbackManager == nil {
		return h.resp.Warning("反馈功能暂不可用")
	}

	if args == "" {
		return h.resp.Info("📝 报告问题\n\n" +
			"格式: /feedback <问题类型> <媒体ID> <描述>\n\n" +
			"问题类型:\n" +
			"• audio - 🔊 音频问题\n" +
			"• subtitle - 📝 字幕问题\n" +
			"• video - 🎬 视频问题\n" +
			"• other - 💬 其他问题\n\n" +
			"示例: /feedback video 12345 这部电影画面模糊")
	}

	// Parse args: <type> [mediaID] <message>
	parts := strings.Fields(args)
	if len(parts) < 2 {
		return h.resp.InvalidInput("格式错误，请使用: /feedback <类型> <描述>\n\n或者: /feedback <类型> <媒体ID> <描述>")
	}

	problemType := parts[0]
	var message string
	var mediaID int

	// Check if second part is a number (media ID)
	if len(parts) >= 2 {
		if id, err := strconv.Atoi(parts[1]); err == nil && len(parts) >= 3 {
			mediaID = id
			message = strings.Join(parts[2:], " ")
		} else {
			message = strings.Join(parts[1:], " ")
		}
	}

	if message == "" {
		return h.resp.InvalidInput("请提供问题描述")
	}

	// Default media type if no media ID provided
	mediaType := "movie"
	if mediaID == 0 {
		// No media ID, create a general issue
		mediaID = 1 // Use a dummy ID for general issues
	}

	// Create issue
	issue, err := h.feedbackManager.CreateIssue(session.UserID, fmt.Sprintf("用户%d", session.UserID), problemType, message, mediaID, mediaType)
	if err != nil {
		return h.resp.ErrorWithDetails("创建失败", fmt.Sprintf("无法创建问题报告: %s", err.Error()), "请稍后再试或联系管理员")
	}

	return h.resp.Success(fmt.Sprintf("问题已报告！\n\n%s", FormatIssue(issue)))
}

// handleMyIssues shows user's issues
func (h *Handler) handleMyIssues(session *session.UserSession) *MessageResponse {
	if h.feedbackManager == nil {
		return h.resp.Warning("反馈功能暂不可用")
	}

	issues, err := h.feedbackManager.GetMyIssues(session.UserID)
	if err != nil {
		return h.resp.ErrorWithDetails("获取失败", err.Error(), "请稍后再试")
	}

	if len(issues) == 0 {
		return h.resp.Info("📝 您还没有报告过问题")
	}

	msg := fmt.Sprintf("📝 您的问题 (%d 条)\n\n", len(issues))

	for i, issue := range issues {
		if i >= 10 {
			msg += fmt.Sprintf("... 还有 %d 条\n", len(issues)-10)
			break
		}
		msg += FormatIssue(&issue)
		msg += "\n\n"
	}

	return &MessageResponse{
		Text: msg,
	}
}

// handleAllIssues shows all issues (admin)
func (h *Handler) handleAllIssues(session *session.UserSession) *MessageResponse {
	if h.feedbackManager == nil {
		return h.resp.Warning("反馈功能暂不可用")
	}

	issues, err := h.feedbackManager.GetAllIssues(20)
	if err != nil {
		return h.resp.ErrorWithDetails("获取失败", err.Error(), "请稍后再试")
	}

	if len(issues) == 0 {
		return h.resp.Info("📝 暂无问题报告")
	}

	msg := fmt.Sprintf("📝 所有问题 (%d 条)\n\n", len(issues))

	for i, issue := range issues {
		if i >= 15 {
			msg += fmt.Sprintf("... 还有 %d 条\n", len(issues)-15)
			break
		}
		msg += FormatIssue(&issue)
		msg += fmt.Sprintf(" 👤 %s\n\n", issue.CreatedBy.DisplayName)
	}

	return &MessageResponse{
		Text: msg,
	}
}

// containsAny checks if the text contains any of the keywords
func containsAny(text string, keywords []string) bool {
	for _, kw := range keywords {
		if strings.Contains(text, kw) {
			return true
		}
	}
	return false
}

// handleSearch handles search queries
func (h *Handler) handleSearch(session *session.UserSession, query string) *MessageResponse {
	h.mu.RLock()
	handler, exists := h.searchHandlers["default"]
	h.mu.RUnlock()

	if !exists {
		return h.resp.Warning("搜索功能暂不可用")
	}

	// Reset to first page for new search
	if session.SearchQuery != query {
		session.SearchQuery = query
		session.CurrentPage = 0
	}

	result, err := handler(session.UserID, query, session.CurrentPage)
	if err != nil {
		return h.resp.SearchError(query, err)
	}

	if result == nil || len(result.Items) == 0 {
		return h.resp.SearchNoResults(query)
	}

	// Store results in session
	session.SearchResults = result.Items
	session.TotalResults = result.Total

	// Build response with inline keyboard
	return h.buildSearchResultsMessage(session, result)
}

// handleNumericInput handles numeric selections (1-8 for items, 0 for auto)
func (h *Handler) handleNumericInput(session *session.UserSession, input string) *MessageResponse {
	if len(session.SearchResults) == 0 {
		return h.resp.Info("🔍 请先搜索内容\n\n直接输入影片名称即可搜索")
	}

	// Parse input as number
	var num int
	_, err := fmt.Sscanf(input, "%d", &num)
	if err != nil || num < 0 {
		return h.resp.InvalidInput("❌ 无效的输入\n\n请输入数字选择结果，或输入新的关键词搜索")
	}

	// Calculate actual index
	index := num + session.CurrentPage*8 - 1

	if index < 0 || index >= len(session.SearchResults) {
		maxNum := (len(session.SearchResults) - session.CurrentPage*8)
		if maxNum > 8 {
			maxNum = 8
		}
		return h.resp.InvalidInput(fmt.Sprintf("❌ 请输入 1-%d 之间的数字", maxNum))
	}

	// Get selected item
	item := session.SearchResults[index]
	session.SelectedItem = &item

	// Show item details with action buttons
	return h.buildItemDetailsMessage(session, &item)
}

// handlePagination handles page navigation
func (h *Handler) handlePagination(session *session.UserSession, direction int) *MessageResponse {
	if len(session.SearchResults) == 0 {
		return h.resp.Info("📄 没有可翻页的内容\n\n请先搜索内容")
	}

	newPage := session.CurrentPage + direction

	if newPage < 0 {
		return h.resp.Info("⬅️ 已经是第一页了")
	}

	maxPage := (session.TotalResults - 1) / 8
	if newPage > maxPage {
		return h.resp.Info("➡️ 已经是最后一页了")
	}

	session.CurrentPage = newPage

	// Re-send search for new page
	return h.handleSearch(session, session.SearchQuery)
}

// handleActionKeyword handles action keywords (搜索/订阅/洗版)
func (h *Handler) handleActionKeyword(session *session.UserSession, text string) *MessageResponse {
	if strings.HasPrefix(text, "订阅") {
		query := strings.TrimPrefix(text, "订阅")
		query = strings.TrimPrefix(query, ":")
		query = strings.TrimPrefix(query, "：")
		query = strings.TrimSpace(query)
		return h.handleSubscribeCommand(session, query)
	}

	if strings.HasPrefix(text, "洗版") {
		query := strings.TrimPrefix(text, "洗版")
		query = strings.TrimPrefix(query, ":")
		query = strings.TrimPrefix(query, "：")
		query = strings.TrimSpace(query)
		return h.handleBestVersion(session, query)
	}

	// Default to search
	query := strings.TrimPrefix(text, "搜索")
	query = strings.TrimPrefix(query, ":")
	query = strings.TrimPrefix(query, "：")
	query = strings.TrimSpace(query)
	return h.handleSearch(session, query)
}

// handleSubscribeCommand handles subscribe command
func (h *Handler) handleSubscribeCommand(session *session.UserSession, query string) *MessageResponse {
	// First search for the media
	searchResult, err := h.performSearch(session, query)
	if err != nil {
		return h.resp.SearchError(query, err)
	}

	if len(searchResult.Items) == 0 {
		return h.resp.SearchNoResults(query)
	}

	// If only one result, subscribe directly
	if len(searchResult.Items) == 1 {
		item := searchResult.Items[0]
		return h.performSubscribe(session, &item)
	}

	// Store results and show selection
	session.SearchResults = searchResult.Items
	session.TotalResults = searchResult.Total
	session.PendingAction = "subscribe"

	return h.buildSearchResultsMessage(session, searchResult)
}

// handleBestVersion handles best version (洗版) command
func (h *Handler) handleBestVersion(session *session.UserSession, query string) *MessageResponse {
	// Similar to subscribe but with best_version flag
	return h.handleSubscribeCommand(session, query)
}

// Helper methods

func (h *Handler) isNumericInput(text string) bool {
	text = strings.TrimSpace(text)
	for _, c := range text {
		if c < '0' || c > '9' {
			return false
		}
	}
	return len(text) > 0
}

func (h *Handler) performSearch(session *session.UserSession, query string) (*SearchResult, error) {
	h.mu.RLock()
	handler, exists := h.searchHandlers["default"]
	h.mu.RUnlock()

	if !exists {
		return nil, fmt.Errorf("搜索功能不可用")
	}

	return handler(session.UserID, query, 0)
}

func (h *Handler) performSubscribe(session *session.UserSession, item *SearchItem) *MessageResponse {
	h.mu.RLock()
	handler, exists := h.subscribeHandlers["default"]
	h.mu.RUnlock()

	if !exists {
		return h.resp.Warning("订阅功能暂不可用")
	}

	mediaID := fmt.Sprintf("%s:%s", item.Type, item.ID)
	err := handler(session.UserID, mediaID, 1)
	if err != nil {
		return h.resp.ErrorWithDetails("订阅失败", err.Error(), "请稍后再试")
	}

	return h.resp.SuccessBuilder(fmt.Sprintf("✅ 已订阅: %s", item.Title)).WithEditMode(true).Get()
}

// Message builders

func (h *Handler) sendHelpMessage(session *session.UserSession) *MessageResponse {
	// 检查用户是否已绑定账号
	isBound := false
	if h.quotaManager != nil {
		quota := h.quotaManager.GetUserQuota(session.UserID)
		isBound = quota != nil && (quota.MovieLimit > 0 || quota.TVLimit > 0)
	}

	helpText := "🌟 欢迎使用云海看板娘 🌟\n\n"
	helpText += "我是你的智能媒体助手\n\n"
	helpText += "━━━━━━━━━━━━━━━━\n\n"
	helpText += "📱 快速开始\n\n"
	helpText += "1️⃣ 直接输入影片名搜索\n"
	helpText += "2️⃣ 点击结果查看详情\n"
	helpText += "3️⃣ 点击「📋 发起请求」\n"
	helpText += "4️⃣ 坐等完成，自动通知\n\n"

	if !isBound {
		helpText += "━━━━━━━━━━━━━━━━\n\n"
		helpText += "⚠️ 使用前需要先绑定账号\n\n"
		helpText += "使用 /link 账号 密码 绑定\n\n"
	}

	helpText += "━━━━━━━━━━━━━━━━\n\n"
	helpText += "💡 常用命令\n\n"
	helpText += "• /search - 搜索媒体\n"
	helpText += "• /profile - 我的资料\n"
	helpText += "• /ratings - 我的评分\n"
	helpText += "• /quota - 查看配额\n"
	helpText += "• /lang - 切换语言\n\n"

	if h.isAdmin(session.UserID) {
		helpText += "━━━━━━━━━━━━━━━━\n\n"
		helpText += "⭐ 管理员命令\n\n"
		helpText += "• /pending - 待处理请求\n"
		helpText += "• /approve - 批准请求\n"
		helpText += "• /decline - 拒绝请求\n"
		helpText += "• /allissues - 所有问题\n"
	}

	helpText += "━━━━━━━━━━━━━━━━\n\n"
	helpText += "💬 直接输入影片名即可搜索\n"
	helpText += "试试：「复仇者联盟」「繁花」「权力的游戏」"

	return &MessageResponse{
		Text: helpText,
	}
}

func (h *Handler) buildSearchResultsMessage(session *session.UserSession, result *SearchResult) *MessageResponse {
	var text strings.Builder

	// Header - 更简洁
	totalPages := (result.Total + 7) / 8
	text.WriteString(fmt.Sprintf("🔍 \"%s\" · %d条结果 · %d/%d页\n\n",
		session.SearchQuery, result.Total, session.CurrentPage+1, totalPages))

	// Items - 更紧凑的格式
	for i, item := range result.Items {
		num := i + 1
		text.WriteString(fmt.Sprintf("%d.", num))

		// 标题和年份
		if item.Year > 0 {
			text.WriteString(fmt.Sprintf(" %s (%d)", item.Title, item.Year))
		} else {
			text.WriteString(fmt.Sprintf(" %s", item.Title))
		}

		// 评分
		if item.Rating > 0 {
			text.WriteString(fmt.Sprintf(" ⭐%.1f", item.Rating))
		}

		// 类型标签
		if item.Type == "tv" {
			text.WriteString(" 📺剧集")
		} else if item.Type == "movie" {
			text.WriteString(" 🎬电影")
		}

		// 用户评分（如果有）
		if id, err := strconv.ParseInt(item.ID, 10, 64); err == nil {
			if userRating := getUserRating(session.UserID, id); userRating > 0 {
				text.WriteString(fmt.Sprintf(" 💖%.1f", userRating))
			}
		}

		text.WriteString("\n")
	}

	// Build inline keyboard
	keyboard := [][]map[string]string{}

	// Item buttons - 4个一行
	row := []string{}
	for i := range result.Items {
		row = append(row, fmt.Sprintf("%d", i+1))
		if len(row) == 4 {
			keyboard = append(keyboard, h.buildButtonRow(row, "select", session))
			row = []string{}
		}
	}
	if len(row) > 0 {
		keyboard = append(keyboard, h.buildButtonRow(row, "select", session))
	}

	// Navigation buttons
	navRow := []map[string]string{}
	if session.CurrentPage > 0 {
		navRow = append(navRow, map[string]string{
			"text":         "⬅️ 上一页",
			"callback_data": h.callbackParser.Format("page", fmt.Sprintf("%d", session.CurrentPage)),
		})
	}
	maxPage := (result.Total + 7) / 8
	if session.CurrentPage < maxPage-1 {
		navRow = append(navRow, map[string]string{
			"text":         "下一页➡️",
			"callback_data": h.callbackParser.Format("page", fmt.Sprintf("%d", session.CurrentPage+2)),
		})
	}
	if len(navRow) > 0 {
		keyboard = append(keyboard, navRow)
	}

	// Cancel button
	keyboard = append(keyboard, []map[string]string{{
		"text":         "❌ 取消",
		"callback_data": h.callbackParser.Format("cancel", ""),
	}})

	return &MessageResponse{
		Text:     text.String(),
		Keyboard: keyboard,
		EditMode: session.LastMessageID > 0,
	}
}

func (h *Handler) buildItemDetailsMessage(session *session.UserSession, item *SearchItem) *MessageResponse {
	// 复用 callback 响应构建器，转换为 MessageResponse
	cbResp := h.buildItemDetailsCallbackResponse(session, item)

	return &MessageResponse{
		Text:     cbResp.Text,
		Keyboard: cbResp.Keyboard,
		EditMode: cbResp.EditMode,
	}
}

func (h *Handler) buildButtonRow(labels []string, action string, session *session.UserSession) []map[string]string {
	row := []map[string]string{}
	for _, label := range labels {
		row = append(row, map[string]string{
			"text":         label,
			"callback_data": h.callbackParser.FormatWithData(action, map[string]string{
				"index": label,
				"page":  fmt.Sprintf("%d", session.CurrentPage+1),
			}),
		})
	}
	return row
}

// Placeholder handlers for callbacks
func (h *Handler) handleSelectCallback(session *session.UserSession, cb *callback.Callback) *CallbackResponse {
	// Get the index from callback data
	indexStr := cb.Data["index"]
	if indexStr == "" {
		return &CallbackResponse{Text: "无效的选择"}
	}

	// Parse index (1-based)
	index, err := strconv.Atoi(indexStr)
	if err != nil || index < 1 {
		return &CallbackResponse{Text: "无效的编号"}
	}

	// Calculate actual index in results
	actualIndex := (session.CurrentPage * 8) + index - 1

	if actualIndex < 0 || actualIndex >= len(session.SearchResults) {
		return &CallbackResponse{Text: fmt.Sprintf("请输入 1-%d 之间的数字", len(session.SearchResults))}
	}

	// Get selected item
	item := session.SearchResults[actualIndex]
	session.SelectedItem = &item

	// Show item details with action buttons
	return h.buildItemDetailsCallbackResponse(session, &item)
}

func (h *Handler) buildItemDetailsCallbackResponse(session *session.UserSession, item *SearchItem) *CallbackResponse {
	var text strings.Builder

	// Debug logging
	log.Printf("[Handler] Item details: Title='%s', Year=%d, Type='%s', Rating=%.1f, ID='%s'",
		item.Title, item.Year, item.Type, item.Rating, item.ID)

	// Use title if available, otherwise use ID
	displayTitle := item.Title
	if displayTitle == "" {
		displayTitle = fmt.Sprintf("媒体 ID: %s", item.ID)
	}

	// Parse TMDB ID for rating lookup
	tmdbID := int64(0)
	if id, err := strconv.ParseInt(item.ID, 10, 64); err == nil {
		tmdbID = id
	}

	// 媒体类型标签
	mediaType := "电影"
	if item.Type == "tv" {
		mediaType = "剧集"
	} else if item.Type == "" {
		mediaType = "电影/剧集"
	}

	// ========== 第一行：标题 + 年份 ==========
	text.WriteString("🎬 ")
	text.WriteString(displayTitle)
	if item.Year > 0 {
		text.WriteString(fmt.Sprintf(" · %d", item.Year))
	}
	text.WriteString("\n")

	// ========== 第二行：评分、类型、配额 ==========
	infoParts := []string{}

	// 评分
	if item.Rating > 0 {
		infoParts = append(infoParts, fmt.Sprintf("⭐ %.1f", item.Rating))
	}

	// 类型
	infoParts = append(infoParts, mediaType)

	// 我的评分
	if tmdbID > 0 {
		userRating := getUserRating(session.UserID, tmdbID)
		if userRating > 0 {
			infoParts = append(infoParts, fmt.Sprintf("💖 %.1f", userRating))
		}
	}

	// 拼接信息行
	for i, part := range infoParts {
		if i > 0 {
			text.WriteString(" · ")
		}
		text.WriteString(part)
	}
	text.WriteString("\n")

	// ========== 第三行：配额状态（简化） ==========
	if h.quotaManager != nil {
		if h.isAdmin(session.UserID) {
			text.WriteString("⭐ 管理员无限制")
		} else {
			quota := h.quotaManager.GetUserQuota(session.UserID)
			if mediaType == "电影" || item.Type == "movie" {
				remaining := quota.MovieLimit - quota.MovieUsed
				text.WriteString(fmt.Sprintf("📊 剩余 %d/%d", remaining, quota.MovieLimit))
			} else {
				remaining := quota.TVLimit - quota.TVUsed
				text.WriteString(fmt.Sprintf("📊 剩余 %d/%d", remaining, quota.TVLimit))
			}
		}
	}

	// ========== 第四行：剧情简介（有内容才显示） ==========
	if item.Overview != "" {
		text.WriteString("\n\n")
		// 截断过长的简介
		overviewText := item.Overview
		if len(overviewText) > 200 {
			overviewText = overviewText[:197] + "..."
		}
		text.WriteString(overviewText)
	}

	// ========== 构建按钮 ==========
	var keyboard [][]map[string]string

	// 检查配额状态
	isAdmin := h.isAdmin(session.UserID)
	hasQuota := true
	buttonText := "📋 发起请求"

	if !isAdmin && h.quotaManager != nil {
		quota := h.quotaManager.GetUserQuota(session.UserID)
		if mediaType == "电影" || item.Type == "movie" {
			if quota.MovieUsed >= quota.MovieLimit {
				hasQuota = false
				buttonText = "🚫 配额用完"
			}
		} else if mediaType == "剧集" || item.Type == "tv" {
			if quota.TVUsed >= quota.TVLimit {
				hasQuota = false
				buttonText = "🚫 配额用完"
			}
		}
	}

	// 第一行：发起请求 + 评分
	firstRow := []map[string]string{
		{"text": buttonText, "callback_data": h.callbackParser.FormatWithData("subscribe", map[string]string{
			"id":    item.ID,
			"title": displayTitle,
			"type":  item.Type,
		})},
	}

	// 添加评分按钮
	if tmdbID > 0 {
		userRating := getUserRating(session.UserID, tmdbID)
		rateButtonText := "⭐ 评分"
		if userRating > 0 {
			rateButtonText = fmt.Sprintf("⭐ %.1f", userRating)
		}
		firstRow = append(firstRow, map[string]string{
			"text": rateButtonText, "callback_data": h.callbackParser.FormatWithData("rate_menu", map[string]string{
				"id": fmt.Sprintf("%d", tmdbID),
			})},
		})
	}

	// 第二行：导航
	navRow := []map[string]string{
		{"text": "⬅️ 返回", "callback_data": h.callbackParser.FormatWithData("back", map[string]string{
			"target": "results",
		})},
		{"text": "❌", "callback_data": h.callbackParser.Format("cancel", "")},
	}
	keyboard = append(keyboard, navRow)

	return &CallbackResponse{
		Text:     text.String(),
		Keyboard: keyboard,
		EditMode:  true,
	}
}

func (h *Handler) handleSearchCallback(session *session.UserSession, cb *callback.Callback) *CallbackResponse {
	return h.resp.Loading("搜索中...").ToCallbackResponse()
}

func (h *Handler) handleSubscribeCallback(session *session.UserSession, cb *callback.Callback) *CallbackResponse {
	// Get media ID and title from callback data
	mediaID := cb.Data["id"]
	title := cb.Data["title"]
	mediaType := cb.Data["type"]

	if mediaID == "" {
		return h.resp.ErrorWithDetailsBuilder("操作失败", "缺少媒体信息", "请重新搜索后重试").ToCallbackResponse()
	}

	log.Printf("[Handler] Subscribe request: mediaID=%s, title=%s, userID=%d, type=%s", mediaID, title, session.UserID, mediaType)

	// Determine media type for quota check
	quotaMediaType := "movie"
	if mediaType == "tv" {
		quotaMediaType = "tv"
	}

	// Check if user is admin - admins bypass quota check
	if h.isAdmin(session.UserID) {
		log.Printf("[Handler] User %d is admin, bypassing quota check", session.UserID)
	} else if h.quotaManager != nil {
		// Check quota if available - with better message
		quota := h.quotaManager.GetUserQuota(session.UserID)
		canRequest := false

		if quotaMediaType == "movie" {
			canRequest = quota.MovieUsed < quota.MovieLimit
		} else {
			canRequest = quota.TVUsed < quota.TVLimit
		}

		if !canRequest {
			// Use response system for quota exhausted
			return h.resp.QuotaExhausted(quotaMediaType, quota.MovieUsed+quota.TVUsed, quota.MovieLimit+quota.TVLimit)
		}
	}

	// Convert string ID to int
	id, err := strconv.Atoi(mediaID)
	if err != nil {
		return h.resp.ErrorWithDetailsBuilder("操作失败", "媒体信息格式错误", "请重新搜索后重试").ToCallbackResponse()
	}

	// Call subscribe handler
	h.mu.RLock()
	handler, exists := h.subscribeHandlers["default"]
	h.mu.RUnlock()

	if !exists {
		return h.resp.ErrorWithDetailsBuilder("操作失败", "订阅功能暂时不可用", "请稍后再试或联系管理员").ToCallbackResponse()
	}

	// Use movie as default type (Jellyseerr will auto-detect)
	requestMediaType := "movie"
	if mediaType == "tv" {
		requestMediaType = "tv"
	}
	fullMediaID := fmt.Sprintf("%s:%d", requestMediaType, id)

	log.Printf("[Handler] Calling subscribe handler with: %s", fullMediaID)

	err = handler(session.UserID, fullMediaID, 0)
	if err != nil {
		log.Printf("[Handler] Subscribe error: %v", err)

		// Check for common errors and provide helpful messages
		errMsg := err.Error()
		if strings.Contains(errMsg, "请先使用") || strings.Contains(errMsg, "绑定账号") {
			return h.resp.AccountNotLinked()
		}

		// Check if media already exists in library
		if strings.Contains(errMsg, "已存在") || strings.Contains(errMsg, "already exists") || strings.Contains(errMsg, "available") {
			displayTitle := title
			if displayTitle == "" {
				displayTitle = "这部内容"
			}
			return h.resp.MediaAlreadyAvailable(displayTitle)
		}

		// Generic error with helpful message
		displayTitle := title
		if displayTitle == "" {
			displayTitle = "这部内容"
		}
		return h.resp.RequestFailed(displayTitle, errMsg)
	}

	// Increment quota usage
	if h.quotaManager != nil {
		h.quotaManager.IncrementUsage(session.UserID, quotaMediaType)
	}

	// Return success message using response system
	displayTitle := title
	if displayTitle == "" {
		displayTitle = "这部内容"
	}

	// Get quota info for display
	var quotaUsed, quotaLimit int
	isAdmin := h.isAdmin(session.UserID)
	if h.quotaManager != nil && !isAdmin {
		quota := h.quotaManager.GetUserQuota(session.UserID)
		if quotaMediaType == "movie" {
			quotaUsed, quotaLimit = quota.MovieUsed, quota.MovieLimit
		} else {
			quotaUsed, quotaLimit = quota.TVUsed, quota.TVLimit
		}
	}

	return h.resp.RequestSuccess(displayTitle, quotaMediaType, quotaUsed, quotaLimit, quotaLimit-quotaUsed, isAdmin)
}

func (h *Handler) handleDownloadCallback(session *session.UserSession, cb *callback.Callback) *CallbackResponse {
	return h.resp.InfoBuilder("下载功能开发中...").ToCallbackResponse()
}

func (h *Handler) handlePageCallback(session *session.UserSession, cb *callback.Callback) *CallbackResponse {
	// Get page from callback data
	pageStr := cb.Data["page"]
	if pageStr == "" {
		// If no page specified, use "back" as indicator to return to results
		return h.buildSearchResultsCallbackResponse(session)
	}

	page, err := strconv.Atoi(pageStr)
	if err != nil || page < 1 {
		page = 1
	}

	// Update session page
	session.CurrentPage = page - 1

	// Re-build search results message
	return h.buildSearchResultsCallbackResponse(session)
}

func (h *Handler) handleCancelCallback(session *session.UserSession, cb *callback.Callback) *CallbackResponse {
	// Clear session state
	session.SearchResults = nil
	session.SearchQuery = ""
	session.SelectedItem = nil
	session.CurrentPage = 0

	return h.resp.InfoBuilder("❌ 已取消").WithEditMode(true).ToCallbackResponse()
}

// handleBackCallback handles returning to previous view
func (h *Handler) handleBackCallback(session *session.UserSession, cb *callback.Callback) *CallbackResponse {
	target := cb.Data["target"]
	log.Printf("[Handler] handleBackCallback: target=%s, resultsCount=%d", target, len(session.SearchResults))

	if target == "results" || target == "" {
		return h.buildSearchResultsCallbackResponse(session)
	}

	if target == "details" && session.SelectedItem != nil {
		return h.buildItemDetailsCallbackResponse(session, session.SelectedItem)
	}

	return h.resp.WarningBuilder("未知返回目标").ToCallbackResponse()
}

// ===================================================================
// Rating Callback Handlers
// ===================================================================

// handleRateMenuCallback shows the rating menu
func (h *Handler) handleRateMenuCallback(session *session.UserSession, cb *callback.Callback) *CallbackResponse {
	log.Printf("[Handler] handleRateMenuCallback: Data=%v, Raw=%s", cb.Data, cb.Raw)

	tmdbIDStr := cb.Data["id"]
	if tmdbIDStr == "" {
		// Try parsing from raw format "rate_menu:id:123456" or "rate_menu:123456"
		parts := strings.Split(cb.Raw, ":")
		if len(parts) >= 2 {
			// If we have "rate_menu:id:123456", use the third part
			if len(parts) >= 3 && parts[1] == "id" {
				tmdbIDStr = parts[2]
			} else {
				// Otherwise use the second part as the ID
				tmdbIDStr = parts[1]
			}
		}
	}

	if tmdbIDStr == "" {
		return &CallbackResponse{
			ShowAlert: true,
			Text:     "无效的媒体 ID：ID 为空",
		}
	}

	tmdbID, err := strconv.ParseInt(tmdbIDStr, 10, 64)
	if err != nil {
		log.Printf("[Handler] Failed to parse tmdbID: '%s', error: %v", tmdbIDStr, err)
		return &CallbackResponse{
			ShowAlert: true,
			Text:     fmt.Sprintf("无效的媒体 ID: %s", tmdbIDStr),
		}
	}

	log.Printf("[Handler] Showing rating menu for tmdbID=%d", tmdbID)

	// Get current user rating
	currentRating := getUserRating(session.UserID, tmdbID)

	var text strings.Builder
	text.WriteString("⭐ 为这部作品评分\n\n")

	if session.SelectedItem != nil {
		text.WriteString(fmt.Sprintf("🎬 %s\n\n", session.SelectedItem.Title))
	}

	if currentRating > 0 {
		text.WriteString(fmt.Sprintf("💖 你的评分: %.1f 分\n\n", currentRating))
		text.WriteString("选择新评分将覆盖原有评分\n\n")
	} else {
		text.WriteString("请选择 1-10 分的评分\n\n")
	}

	text.WriteString("━━━━━━━━━━━━━━━━\n")

	// Build rating keyboard (two rows of 5)
	keyboard := [][]map[string]string{}

	// Row 1: 1-5
	row1 := []map[string]string{}
	for i := 1; i <= 5; i++ {
		emoji := "🌟"
		if i <= 2 {
			emoji = "😫"
		} else if i <= 4 {
			emoji = "😐"
		} else if i == 5 {
			emoji = "🙂"
		}
		row1 = append(row1, map[string]string{
			"text":         fmt.Sprintf("%d %s", i, emoji),
			"callback_data": h.callbackParser.FormatWithData("rate", map[string]string{
				"tmdbID": fmt.Sprintf("%d", tmdbID),
				"rating": fmt.Sprintf("%d", i),
			}),
		})
	}
	keyboard = append(keyboard, row1)

	// Row 2: 6-10
	row2 := []map[string]string{}
	for i := 6; i <= 10; i++ {
		emoji := "😀"
		if i <= 7 {
			emoji = "😀"
		} else if i <= 8 {
			emoji = "🤩"
		} else if i == 9 {
			emoji = "🤩🤩"
		} else {
			emoji = "🤩🤩🤩"
		}
		row2 = append(row2, map[string]string{
			"text":         fmt.Sprintf("%d %s", i, emoji),
			"callback_data": h.callbackParser.FormatWithData("rate", map[string]string{
				"tmdbID": fmt.Sprintf("%d", tmdbID),
				"rating": fmt.Sprintf("%d", i),
			}),
		})
	}
	keyboard = append(keyboard, row2)

	// Back button
	if session.SelectedItem != nil {
		keyboard = append(keyboard, []map[string]string{
			{"text": "⬅️ 返回详情", "callback_data": h.callbackParser.FormatWithData("back", map[string]string{
				"target": "details",
			})},
			{"text": "❌ 取消", "callback_data": h.callbackParser.Format("cancel", "")},
		})
	} else {
		keyboard = append(keyboard, []map[string]string{
			{"text": "❌ 取消", "callback_data": h.callbackParser.Format("cancel", "")},
		})
	}

	return &CallbackResponse{
		Text:     text.String(),
		Keyboard: keyboard,
		EditMode:  true,
	}
}

// handleRateCallback handles rating submission
func (h *Handler) handleRateCallback(session *session.UserSession, cb *callback.Callback) *CallbackResponse {
	log.Printf("[Handler] handleRateCallback: Data=%v, Raw=%s", cb.Data, cb.Raw)

	var tmdbID int64
	var rating float64
	var err error

	// Try to parse from Data map first (proper key-value format)
	if tmdbIDStr := cb.Data["tmdbID"]; tmdbIDStr != "" {
		tmdbID, err = strconv.ParseInt(tmdbIDStr, 10, 64)
		if err != nil {
			return &CallbackResponse{
				ShowAlert: true,
				Text:     "无效的媒体 ID",
			}
		}
		ratingStr := cb.Data["rating"]
		if ratingStr == "" {
			return &CallbackResponse{
				ShowAlert: true,
				Text:     "评分数据格式错误：缺少评分值",
			}
		}
		rating, err = strconv.ParseFloat(ratingStr, 64)
		if err != nil || rating < 1 || rating > 10 {
			return &CallbackResponse{
				ShowAlert: true,
				Text:     "评分必须在 1-10 之间",
			}
		}
	} else {
		// Fallback: Parse from raw format "rate:tmdbID:rating" or "rate:123456:8"
		data := cb.Raw
		if data == "" {
			return &CallbackResponse{
				ShowAlert: true,
				Text:     "无效的评分数据",
			}
		}

		// Parse format: rate:tmdbID:rating
		parts := strings.Split(data, ":")
		if len(parts) < 3 {
			return &CallbackResponse{
				ShowAlert: true,
				Text:     fmt.Sprintf("评分数据格式错误: %s (期望: rate:tmdbID:rating)", data),
			}
		}

		tmdbID, err = strconv.ParseInt(parts[1], 10, 64)
		if err != nil {
			return &CallbackResponse{
				ShowAlert: true,
				Text:     "无效的媒体 ID",
			}
		}

		rating, err = strconv.ParseFloat(parts[2], 64)
		if err != nil || rating < 1 || rating > 10 {
			return &CallbackResponse{
				ShowAlert: true,
				Text:     "评分必须在 1-10 之间",
			}
		}
	}

	log.Printf("[Handler] Processing rating: userID=%d, tmdbID=%d, rating=%.1f", session.UserID, tmdbID, rating)

	// Get title if available
	title := ""
	if session.SelectedItem != nil {
		title = session.SelectedItem.Title
	}

	// Submit rating
	if err := rateMedia(session.UserID, tmdbID, rating, title); err != nil {
		log.Printf("[Handler] Rating error: %v", err)
		return h.resp.ErrorWithDetailsBuilder("评分失败", err.Error(), "请稍后再试").ToCallbackResponse()
	}

	// Get updated ratings
	userRating := getUserRating(session.UserID, tmdbID)
	avgRating, count := getAverageRating(tmdbID)

	// Use response system for rating success
	return h.resp.RatingSaved(title, userRating, avgRating, count)
}

// handleLanguageCallback handles language setting callback
func (h *Handler) handleLanguageCallback(session *session.UserSession, cb *callback.Callback) *CallbackResponse {
	// Get action and lang from callback data
	// Format: lang:set:zh or lang:set:en
	action := cb.Data["action"]
	lang := cb.Data["lang"]

	if action != "set" || lang == "" {
		return h.resp.InvalidInputBuilder("无效的操作").ToCallbackResponse()
	}

	// Validate language
	if lang != "zh" && lang != "en" {
		return h.resp.InvalidInputBuilder("无效的语言选项").ToCallbackResponse()
	}

	// Set user language
	SetUserLanguage(session.UserID, lang)

	// Build response message
	var msg strings.Builder
	if lang == "zh" {
		msg.WriteString("✅ 语言已设置为简体中文\n\n")
		msg.WriteString("Language set to Chinese (Simplified)")
	} else {
		msg.WriteString("✅ Language set to English\n\n")
		msg.WriteString("语言已设置为 English")
	}

	return &CallbackResponse{
		Text:     msg.String(),
		ShowAlert: true,
		EditMode:  true,
	}
}

// handleProfileCallback handles profile refresh callback
func (h *Handler) handleProfileCallback(session *session.UserSession, cb *callback.Callback) *CallbackResponse {
	// Rebuild profile message
	return h.buildProfileCallbackResponse(session)
}

// buildProfileCallbackResponse builds the profile response for callback
func (h *Handler) buildProfileCallbackResponse(session *session.UserSession) *CallbackResponse {
	// Re-use the profile command logic
	msgResp := h.handleProfileCommand(session)

	return &CallbackResponse{
		Text:     msgResp.Text,
		Keyboard: msgResp.Keyboard,
		EditMode:  true,
	}
}

// buildSearchResultsCallbackResponse builds the search results response for callback
func (h *Handler) buildSearchResultsCallbackResponse(session *session.UserSession) *CallbackResponse {
	if len(session.SearchResults) == 0 {
		return h.resp.InfoBuilder("🔍 搜索结果已过期\n\n请重新输入关键词搜索").WithEditMode(true).ToCallbackResponse()
	}

	// Calculate pagination
	pageSize := 8
	startIdx := session.CurrentPage * pageSize
	endIdx := startIdx + pageSize
	if endIdx > len(session.SearchResults) {
		endIdx = len(session.SearchResults)
	}

	totalPages := (session.TotalResults + pageSize - 1) / pageSize

	var text strings.Builder
	text.WriteString("🔍 搜索结果\n\n")
	text.WriteString(fmt.Sprintf("📝 关键词：%s\n", session.SearchQuery))
	text.WriteString(fmt.Sprintf("📄 第 %d/%d 页 (共 %d 条结果)\n\n",
		session.CurrentPage+1, totalPages, session.TotalResults))
	text.WriteString("━━━━━━━━━━━━━━━━\n\n")

	// Display current page results
	for i := startIdx; i < endIdx; i++ {
		item := session.SearchResults[i]
		num := i + 1
		text.WriteString(fmt.Sprintf("%d. %s", num, item.Title))
		if item.Year > 0 {
			text.WriteString(fmt.Sprintf(" (%d)", item.Year))
		}
		if item.Rating > 0 {
			text.WriteString(fmt.Sprintf(" ⭐%.1f", item.Rating))
		}
		text.WriteString("\n")
	}

	// Build keyboard
	keyboard := [][]map[string]string{}

	// Item buttons (4 per row)
	row := []string{}
	for i := startIdx; i < endIdx; i++ {
		row = append(row, fmt.Sprintf("%d", i-startIdx+1))
		if len(row) == 4 {
			keyboard = append(keyboard, h.buildButtonRow(row, "select", session))
			row = []string{}
		}
	}
	if len(row) > 0 {
		keyboard = append(keyboard, h.buildButtonRow(row, "select", session))
	}

	// Navigation buttons
	navRow := []map[string]string{}
	if session.CurrentPage > 0 {
		navRow = append(navRow, map[string]string{
			"text":         "⬅️ 上一页",
			"callback_data": h.callbackParser.Format("page", "page", fmt.Sprintf("%d", session.CurrentPage)),
		})
	}
	if session.CurrentPage < totalPages-1 {
		navRow = append(navRow, map[string]string{
			"text":         "下一页➡️",
			"callback_data": h.callbackParser.Format("page", "page", fmt.Sprintf("%d", session.CurrentPage+2)),
		})
	}
	if len(navRow) > 0 {
		keyboard = append(keyboard, navRow)
	}

	// Cancel button
	keyboard = append(keyboard, []map[string]string{{
		"text":         "❌ 取消",
		"callback_data": h.callbackParser.Format("cancel", ""),
	}})

	return &CallbackResponse{
		Text:     text.String(),
		Keyboard: keyboard,
		EditMode:  true,
	}
}

func (h *Handler) handleMyRequests(session *session.UserSession) *MessageResponse {
	return h.resp.Info("我的请求功能开发中...")
}

func (h *Handler) handleStatus(session *session.UserSession) *MessageResponse {
	// Build user status message
	var text strings.Builder
	text.WriteString("👤 我的状态\n\n")
	text.WriteString("━━━━━━━━━━━━━━━━\n\n")

	// User info
	text.WriteString(fmt.Sprintf("🆔 用户 ID: %d\n\n", session.UserID))

	// Account binding status
	if h.quotaManager != nil {
		quota := h.quotaManager.GetUserQuota(session.UserID)
		if quota != nil && (quota.MovieLimit > 0 || quota.TVLimit > 0) {
			text.WriteString("🔗 账号状态: ✅ 已绑定\n\n")
			text.WriteString("📊 今日配额:\n")
			text.WriteString(fmt.Sprintf("   电影: %d/%d\n", quota.MovieUsed, quota.MovieLimit))
			text.WriteString(fmt.Sprintf("   剧集: %d/%d\n\n", quota.TVUsed, quota.TVLimit))
		} else {
			text.WriteString("🔗 账号状态: ❌ 未绑定\n\n")
			text.WriteString("💡 使用 /link 命令绑定账号\n\n")
		}
	}

	// Admin status
	if h.isAdmin(session.UserID) {
		text.WriteString("⭐ 管理员权限: ✅ 已启用\n\n")
	}

	// Language setting
	lang := GetUserLanguage(session.UserID)
	if lang == "zh" {
		text.WriteString("🌐 语言: 🇨🇳 简体中文\n\n")
	} else {
		text.WriteString("🌐 Language: 🇬🇧 English\n\n")
	}

	// Session info
	text.WriteString(fmt.Sprintf("💬 会话 ID: %d\n", session.ChatID))
	if session.LastActive.IsZero() {
		text.WriteString("⏰ 最后活动: 刚刚\n")
	} else {
		text.WriteString(fmt.Sprintf("⏰ 最后活动: %s\n", session.LastActive.Format("2006-01-02 15:04")))
	}

	return &MessageResponse{
		Text: text.String(),
	}
}

func (h *Handler) handleProfileCommand(session *session.UserSession) *MessageResponse {
	// Build comprehensive profile message
	var text strings.Builder
	text.WriteString("👤 个人资料卡片\n\n")
	text.WriteString("━━━━━━━━━━━━━━━━\n\n")

	// User info
	text.WriteString(fmt.Sprintf("🆔 ID: %d\n\n", session.UserID))

	// Account section
	text.WriteString("📋 账户信息\n")
	if h.quotaManager != nil {
		quota := h.quotaManager.GetUserQuota(session.UserID)
		if quota != nil && (quota.MovieLimit > 0 || quota.TVLimit > 0) {
			text.WriteString("状态: ✅ 已绑定\n\n")
			text.WriteString("📊 今日配额使用:\n")
			movieRemaining := quota.MovieLimit - quota.MovieUsed
			tvRemaining := quota.TVLimit - quota.TVUsed
			text.WriteString(fmt.Sprintf("   🎬 电影: %d/%d (剩余 %d)\n", quota.MovieUsed, quota.MovieLimit, movieRemaining))
			text.WriteString(fmt.Sprintf("   📺 剧集: %d/%d (剩余 %d)\n\n", quota.TVUsed, quota.TVLimit, tvRemaining))
		} else {
			text.WriteString("状态: ❌ 未绑定\n")
			text.WriteString("提示: 使用 /link 命令绑定账号\n\n")
		}
	}

	// Rating stats
	ratings := getUserRatings(session.UserID)
	if len(ratings) > 0 {
		text.WriteString(fmt.Sprintf("⭐ 已评分: %d 部作品\n\n", len(ratings)))
	}

	// Admin badge
	if h.isAdmin(session.UserID) {
		text.WriteString("🏆 管理员徽章\n\n")
	}

	// Language
	lang := GetUserLanguage(session.UserID)
	supportedLangs := GetSupportedLanguages()
	if langName, ok := supportedLangs[lang]; ok {
		text.WriteString(fmt.Sprintf("🌐 语言: %s\n\n", langName))
	}

	// Quick actions
	text.WriteString("━━━━━━━━━━━━━━━━\n\n")
	text.WriteString("快捷操作:\n")
	text.WriteString("• /my - 查看我的请求\n")
	text.WriteString("• /ratings - 我的评分\n")
	text.WriteString("• /lang - 切换语言\n")
	if !h.isAdmin(session.UserID) {
		text.WriteString("• /quota - 查看配额\n")
	} else {
		text.WriteString("• /pending - 待处理请求\n")
	}

	return &MessageResponse{
		Text: text.String(),
		Keyboard: [][]map[string]string{
			{
				{"text": "🔄 刷新", "callback_data": "profile:refresh"},
			},
		},
	}
}

func (h *Handler) handlePending(session *session.UserSession) *MessageResponse {
	return h.resp.Info("待处理功能开发中...")
}

// TelegramUpdate represents an incoming update from Telegram
type TelegramUpdate struct {
	UpdateID int64 `json:"update_id"`
	Message  *struct {
		MessageID int64 `json:"message_id"`
		From      struct {
			ID        int64  `json:"id"`
			IsBot     bool   `json:"is_bot"`
			FirstName string `json:"first_name"`
			LastName  string `json:"last_name"`
			Username  string `json:"username"`
		} `json:"from"`
		Chat struct {
			ID int64 `json:"id"`
			Type string `json:"type"`
		} `json:"chat"`
		Date int64 `json:"date"`
		Text string `json:"text"`
	} `json:"message"`
	CallbackQuery *struct {
		ID      string `json:"id"`
		From    struct {
			ID        int64  `json:"id"`
			IsBot     bool   `json:"is_bot"`
			FirstName string `json:"first_name"`
			Username  string `json:"username"`
		} `json:"from"`
		Message struct {
			MessageID int64 `json:"message_id"`
			Chat      struct {
				ID int64 `json:"id"`
			} `json:"chat"`
		} `json:"message"`
		Data string `json:"callback_data"`
	} `json:"callback_query"`
}

// JSONMessage is used for sending messages to Telegram
type JSONMessage struct {
	ChatID      int64                    `json:"chat_id"`
	Text        string                   `json:"text"`
	ParseMode   string                   `json:"parse_mode,omitempty"`
	ReplyMarkup *TelegramInlineKeyboard  `json:"reply_markup,omitempty"`
}

// TelegramInlineKeyboard represents inline keyboard markup
type TelegramInlineKeyboard struct {
	InlineKeyboard [][]map[string]string `json:"inline_keyboard"`
}

// JSONToUpdate converts JSON to TelegramUpdate
func JSONToUpdate(data []byte) (*TelegramUpdate, error) {
	var update TelegramUpdate
	err := json.Unmarshal(data, &update)
	if err != nil {
		return nil, err
	}
	return &update, nil
}

// HTTP handlers for Gin framework
func (h *Handler) GinHandler() gin.HandlerFunc {
	return func(c *gin.Context) {
		var data []byte
		if c.Request.Body != nil {
			data, _ = c.GetRawData()
		}

		update, err := JSONToUpdate(data)
		if err != nil {
			c.JSON(400, gin.H{"error": "Invalid JSON"})
			return
		}

		response := h.HandleMessage(update)
		if response != nil {
			// Send response via message editor
			if update.Message != nil {
				chatID := update.Message.Chat.ID
				messageID := update.Message.MessageID

				if response.EditMode && messageID > 0 {
					h.messageEditor.EditMessage(chatID, messageID, response.Text, response.Keyboard)
				} else {
					h.messageEditor.SendMessage(chatID, response.Text, response.Keyboard)
				}
			}
		}

		c.JSON(200, gin.H{"status": "ok"})
	}
}

func (h *Handler) GinCallbackHandler() gin.HandlerFunc {
	return func(c *gin.Context) {
		var data []byte
		if c.Request.Body != nil {
			data, _ = c.GetRawData()
		}

		update, err := JSONToUpdate(data)
		if err != nil {
			c.JSON(400, gin.H{"error": "Invalid JSON"})
			return
		}

		response := h.HandleCallback(update)
		if response != nil {
			// Answer callback query
			if update.CallbackQuery != nil {
				h.messageEditor.AnswerCallback(update.CallbackQuery.ID, response.Text, response.ShowAlert)

				// Edit message if needed
				if response.EditMode {
					chatID := update.CallbackQuery.Message.Chat.ID
					messageID := update.CallbackQuery.Message.MessageID
					// Build new message text based on action
					h.messageEditor.EditMessage(chatID, messageID, response.Text, nil)
				}
			}
		}

		c.JSON(200, gin.H{"status": "ok"})
	}
}

// SetSessionManager sets the session manager dependency
func (h *Handler) SetSessionManager(sm *session.SessionManager) {
	h.sessionManager = sm
}

// SetMessageEditor sets the message editor dependency
func (h *Handler) SetMessageEditor(me *MessageEditor) {
	h.messageEditor = me
}

// SetQuotaManager sets the quota manager dependency
func (h *Handler) SetQuotaManager(qm *QuotaManager) {
	h.quotaManager = qm
}

// SetFeedbackManager sets the feedback manager dependency
func (h *Handler) SetFeedbackManager(fm *FeedbackManager) {
	h.feedbackManager = fm
}

// SetAdmins sets the admin list
func (h *Handler) SetAdmins(admins map[int64]string) {
	h.mu.Lock()
	defer h.mu.Unlock()
	h.admins = admins
}

// isAdmin checks if user is an admin
func (h *Handler) isAdmin(userID int64) bool {
	h.mu.RLock()
	defer h.mu.RUnlock()
	_, exists := h.admins[userID]
	return exists
}

// Cleanup
func (h *Handler) Stop() {
	h.sessionManager.Stop()
}

// ===================================================================
// Rating System Integration
// ===================================================================

// handleRateCommand handles the /rate command
func (h *Handler) handleRateCommand(session *session.UserSession, args string) *MessageResponse {
	// Parse args: /rate <tmdbID> <rating> [title]
	// Example: /rate 12345 8.5 阿凡达

	if args == "" {
		return h.handleRateHelp()
	}

	parts := strings.Fields(args)
	if len(parts) < 2 {
		return h.handleRateHelp()
	}

	// Parse TMDB ID
	tmdbID, err := strconv.ParseInt(parts[0], 10, 64)
	if err != nil {
		return h.resp.InvalidInput("❌ 格式错误\n\nTMDB ID 必须是数字\n\n使用 /rate 查看帮助")
	}

	// Parse rating
	rating, err := strconv.ParseFloat(parts[1], 64)
	if err != nil || rating < 1 || rating > 10 {
		return h.resp.InvalidInput("❌ 格式错误\n\n评分必须在 1-10 之间\n\n使用 /rate 查看帮助")
	}

	// Get title if provided
	title := ""
	if len(parts) >= 3 {
		title = strings.Join(parts[2:], " ")
	} else if session.SelectedItem != nil {
		title = session.SelectedItem.Title
	}

	// Call rating system (via bridge)
	if err := rateMedia(session.UserID, tmdbID, rating, title); err != nil {
		return h.resp.ErrorWithDetails("评分失败", err.Error(), "请检查TMDB ID是否正确")
	}

	// Get user's new rating
	userRating := getUserRating(session.UserID, tmdbID)
	avgRating, count := getAverageRating(tmdbID)

	var msg strings.Builder
	msg.WriteString("✅ 评分成功！\n\n")
	if title != "" {
		msg.WriteString(fmt.Sprintf("🎬 %s\n\n", title))
	}
	msg.WriteString(fmt.Sprintf("⭐ 你的评分: %.1f/10\n", userRating))
	msg.WriteString(fmt.Sprintf("📊 平均评分: %.1f/10 (%d人评分)", avgRating, count))

	return h.resp.Success(msg.String())
}

// handleRateHelp shows help for /rate command
func (h *Handler) handleRateHelp() *MessageResponse {
	return h.resp.Info(`📝 评分帮助

为看过的影视作品打分！

━━━━━━━━━━━━━━━━━━━━━

格式:
/rate <TMDB_ID> <评分> [标题]

示例:
/rate 19995 8.5 阿凡达
/rate 1399 9.0 盗梦空间

━━━━━━━━━━━━━━━━━━━━━

💡 提示:
• 评分范围: 1-10 分
• TMDB ID 可以从搜索结果中获得
• 评分后可以随时修改`)
}

// handleRatingsCommand shows user's ratings
func (h *Handler) handleRatingsCommand(session *session.UserSession) *MessageResponse {
	ratings := getUserRatings(session.UserID)

	if len(ratings) == 0 {
		return h.resp.Info(`📝 我的评分

你还没有评分过任何作品

━━━━━━━━━━━━━━━━━━━━━

使用 /rate <ID> <评分> 为看过的作品打分`)
	}

	var msg strings.Builder
	msg.WriteString("📝 我的评分\n\n")
	msg.WriteString(fmt.Sprintf("共评分了 %d 部作品\n\n", len(ratings)))
	msg.WriteString("━━━━━━━━━━━━━━━━\n\n")

	// Show up to 20 ratings
	count := 0
	for tmdbID, rating := range ratings {
		if count >= 20 {
			msg.WriteString(fmt.Sprintf("... 还有 %d 部作品\n\n", len(ratings)-20))
			break
		}

		avg, avgCount := getAverageRating(tmdbID)
		msg.WriteString(fmt.Sprintf("⭐ %.1f 分 | ID:%d (平均 %.1f, %d人)\n",
			rating, tmdbID, avg, avgCount))
		count++
	}

	return h.resp.Info(msg.String())
}

// ===================================================================
// Language System Integration
// ===================================================================

// handleLanguageCommand handles the /lang command
func (h *Handler) handleLanguageCommand(session *session.UserSession, args string) *MessageResponse {
	// If no args, show current language and options
	if args == "" {
		currentLang := GetUserLanguage(session.UserID)
		supportedLangs := GetSupportedLanguages()

		var text strings.Builder
		text.WriteString("🌐 语言设置 / Language Settings\n\n")

		if currentLang == "zh" || currentLang == "" {
			text.WriteString("当前语言: 🇨🇳 简体中文\n\n")
		} else {
			text.WriteString(fmt.Sprintf("当前语言: %s\n\n", supportedLangs[currentLang]))
		}

		text.WriteString("━━━━━━━━━━━━━━━━\n\n")
		text.WriteString("选择语言 / Select Language:\n\n")

		return h.resp.InfoBuilder(text.String()).WithKeyboard([][]map[string]string{
			{
				{"text": "🇨🇳 简体中文", "callback_data": "lang:set:zh"},
				{"text": "🇬🇧 English", "callback_data": "lang:set:en"},
			},
		}).Get()
	}

	// Handle direct language setting via command
	// /lang zh or /lang en
	lang := strings.ToLower(args)
	if lang == "zh" || lang == "chinese" || lang == "中文" {
		SetUserLanguage(session.UserID, "zh")
		return h.resp.Success("✅ 语言已设置为简体中文\n\nLanguage set to Chinese (Simplified)")
	} else if lang == "en" || lang == "english" {
		SetUserLanguage(session.UserID, "en")
		return h.resp.Success("✅ Language set to English\n\n语言已设置为 English")
	} else {
		return h.resp.InvalidInput("❌ 无效的语言选项\n\n请选择: zh (中文) 或 en (English)\n\nInvalid option. Please choose: zh or en")
	}
}

// ===================================================================
// Recommendation System Integration
// ===================================================================

// Recommendation manager instance
var recommendManager *RecommendationManager

// SetRecommendationManager sets the recommendation manager
func (h *Handler) SetRecommendationManager(rm *RecommendationManager) {
	recommendManager = rm
}

// handleRecommendCommand handles the /recommend command
func (h *Handler) handleRecommendCommand(session *session.UserSession, args string) *MessageResponse {
	recType := "similar" // Default
	if args != "" {
		recTypeMap := map[string]string{
			"similar":   "similar",
			"trending":  "trending",
			"热门":      "trending",
			"discovery": "discovery",
			"探索":      "discovery",
			"social":    "social",
			"大家":      "social",
		}
		if t, ok := recTypeMap[args]; ok {
			recType = t
		}
	}

	return h.buildRecommendationMessage(session, recType)
}

// buildRecommendationMessage builds recommendation message
func (h *Handler) buildRecommendationMessage(session *session.UserSession, recType string) *MessageResponse {
	if recommendManager == nil {
		return &MessageResponse{
			Text: "推荐功能暂不可用",
		}
	}

	text, keyboard := recommendManager.BuildRecommendationMessage(session.UserID, recType)

	return &MessageResponse{
		Text:     text,
		Keyboard: keyboard,
	}
}

// handleRecommendCallback handles recommendation-related callbacks
func (h *Handler) handleRecommendCallback(session *session.UserSession, cb *callback.Callback) *CallbackResponse {
	log.Printf("[Handler] handleRecommendCallback: Data=%v, Raw=%s", cb.Data, cb.Raw)

	// The callback format is "rec:type" where type is similar, trending, discovery, social
	// We need to extract the type from the raw string
	var recType string

	// First try to get from Data map (if properly formatted)
	if t := cb.Data["type"]; t != "" {
		recType = t
	} else {
		// Parse from raw format like "rec:similar" or "rec:trending"
		parts := strings.Split(cb.Raw, ":")
		if len(parts) >= 2 {
			recType = parts[1]
		} else {
			recType = "similar" // Default
		}
	}

	log.Printf("[Handler] Recommendation type: %s", recType)

	switch recType {
	case "menu":
		// Show recommendation menu
		return &CallbackResponse{
			Text: "✨ 智能推荐\n\n请选择推荐类型：",
			Keyboard: [][]map[string]string{
				{
					{"text": "🎯 为你推荐", "callback_data": "rec:similar"},
					{"text": "🔥 热门推荐", "callback_data": "rec:trending"},
				},
				{
					{"text": "🎲 探索发现", "callback_data": "rec:discovery"},
					{"text": "👥 大家都在看", "callback_data": "rec:social"},
				},
			},
			EditMode: true,
		}

	case "back":
		// Return to recommendation menu
		return &CallbackResponse{
			Text: "✨ 智能推荐\n\n请选择推荐类型：",
			Keyboard: [][]map[string]string{
				{
					{"text": "🎯 为你推荐", "callback_data": "rec:similar"},
					{"text": "🔥 热门推荐", "callback_data": "rec:trending"},
				},
				{
					{"text": "🎲 探索发现", "callback_data": "rec:discovery"},
					{"text": "👥 大家都在看", "callback_data": "rec:social"},
				},
			},
			EditMode: true,
		}

	default:
		// Show recommendations of the specified type (similar, trending, discovery, social)
		// Validate recType
		validTypes := map[string]bool{
			"similar":   true,
			"trending":  true,
			"discovery": true,
			"social":    true,
		}

		if !validTypes[recType] {
			return h.resp.InvalidInputBuilder("❌ 无效的推荐类型\n\n请重新选择推荐类型").WithKeyboard(recommendManager.GetRecommendationMenu()).WithEditMode(true).ToCallbackResponse()
		}

		text, keyboard := recommendManager.BuildRecommendationMessage(session.UserID, recType)
		return &CallbackResponse{
			Text:     text,
			Keyboard: keyboard,
			EditMode: true,
		}
	}
}

// handleQuickRequestCallback handles quick request from recommendation
func (h *Handler) handleQuickRequestCallback(session *session.UserSession, cb *callback.Callback) *CallbackResponse {
	log.Printf("[Handler] handleQuickRequestCallback: Data=%v", cb.Data)

	mediaID := cb.Data["id"]
	title := cb.Data["title"]
	mediaType := cb.Data["type"]

	if mediaID == "" {
		return h.resp.ErrorWithDetailsBuilder("操作失败", "缺少媒体信息", "请重新搜索后重试").ToCallbackResponse()
	}

	// Build item details response
	item := &SearchItem{
		ID:    mediaID,
		Title: title,
		Type:  mediaType,
	}
	session.SelectedItem = item

	return h.buildItemDetailsCallbackResponse(session, item)
}


