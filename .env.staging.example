# YiMao staging only. Never reuse production credentials or endpoints.
STAGING_CONFIRM_ISOLATED=false
STAGING_EXPECTED_BOT_USERNAME=
STAGING_BASE_URL=http://127.0.0.1:18080
STAGING_SMOKE_CHAT_ID=
STAGING_REQUIRE_CHAT=true

# Required isolated Telegram test bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
ADMIN_USER_IDS=

# Required isolated MoviePilot test instance
MOVIEPILOT_URL=
MOVIEPILOT_API_KEY=
DOWNLOAD_SAVE_PATH=/downloads/yimao-staging

# Local staging service
HOST=127.0.0.1
PORT=18080
TZ=Asia/Shanghai
LOG_LEVEL=info
LOG_PREFIX=YiMao-Staging
LOG_COLOR=false
DATA_DIR=/app/data

# HTTP API security — keep enabled in staging
ENABLE_API_AUTH=true
API_KEYS=
ENABLE_RATE_LIMIT=true
ENABLE_IP_BLOCKING=true

# Optional integrations; leave empty unless they are isolated test services
EMBY_URL=
EMBY_API_KEY=
TMDB_API_KEY=
AI_ENABLED=false
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
ZHIPU_API_KEY=
CLAUDE_API_KEY=

# Keep polling mode for a local-only staging instance
WEBHOOK_URL=
WEBHOOK_SECRET=
ENABLE_RICH_MESSAGE=true
UI_STYLE=card
NOTIFICATION_FORMAT=detailed
DAILY_SUMMARY_HOUR=21
WISH_RESEARCH_INTERVAL_HOURS=24
WISH_EXPIRE_DAYS=30
WISH_MIN_SEEDERS=1

PUID=0
PGID=0
